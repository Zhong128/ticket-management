# Copy to .env. For existing volumes, use the existing database/broker credentials.
OPENAI_API_KEY=''
SPRING_DATASOURCE_USERNAME='root'
SPRING_DATASOURCE_PASSWORD='replace-with-local-mysql-password'
SPRING_DATA_REDIS_PASSWORD=''
SPRING_RABBITMQ_USERNAME='tm'
SPRING_RABBITMQ_PASSWORD='replace-with-local-rabbitmq-password'
SPRING_MAIL_USERNAME=''
SPRING_MAIL_PASSWORD=''
WECHAT_APP_ID=''
WECHAT_APP_SECRET=''
WECHAT_REDIRECT_URI='http://localhost:8080/api/auth/wechat/callback'
ALIPAY_APP_ID=''
ALIPAY_MERCHANT_PRIVATE_KEY=''
ALIPAY_PUBLIC_KEY=''
# 应用公钥由应用私钥导出并上传到支付宝开放平台，后端运行时无需单独配置。
ALIPAY_NOTIFY_URL='http://localhost:8080/api/public/payments/notify'
ALIPAY_RETURN_URL='http://localhost:8080/api/public/payments/return'
MYSQL_ROOT_PASSWORD='replace-with-local-mysql-password'
RABBITMQ_DEFAULT_USER='tm'
RABBITMQ_DEFAULT_PASS='replace-with-local-rabbitmq-password'
# 完成受控迁移和校验前保持关闭；不要在已有数据库上自动迁移。
TRADE_ENABLED='false'
TRADE_MIGRATIONS_ENABLED='false'
SECKILL_LOCK_SEGMENTS='20'
SECKILL_LOCK_ENABLED='true'
SECKILL_LOCK_WAIT_MILLIS='200'
SECKILL_CONSUMER_CONCURRENT='3'
SECKILL_CONSUMER_MAX_CONCURRENT='10'
SECKILL_CONSUMER_PREFETCH='10'
SECKILL_PROVISIONAL_DELAY_MILLIS='5000'
SECKILL_ORDER_RECOVERY_DELAY_MILLIS='60000'
